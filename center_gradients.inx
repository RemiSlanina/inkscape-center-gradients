<?xml version="1.0" encoding="UTF-8"?>
<inkscape-extension xmlns="http://www.inkscape.org/namespace/inkscape/extension">
    <name>Center Gradients Test</name>
    <id>org.example.center_gradients</id>

    <effect needs-document="true">
        <object-type>all</object-type>
        <effects-menu>
            <submenu name="Test"/>
        </effects-menu>
    </effect>

    <script>
        <command location="inx" interpreter="python">center_gradients.py</command>
    </script>
</inkscape-extension>